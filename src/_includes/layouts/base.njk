<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#078844">
  <title>{% if page.url == '/' %}{{ title }}{% else %}{{ title | replace(' — СтройГаз', '') }} · СтройГаз{% endif %}</title>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/golos-text/GolosText-Variable.ttf" as="font" type="font/ttf" crossorigin>
  <link rel="stylesheet" href="/assets/ids.css">
  <link rel="stylesheet" href="/assets/style.css">
  <noscript><style>.project-media:not(.is-loaded) > .project-photo, .project-media:not(.is-loaded) > .project-client-badge, .project-media:not(.is-loaded) > .project-logo-contrast { visibility: visible; }</style></noscript>
  {% if gallery %}
  <script src="/assets/vendor/ids/js/lib/photoswipe.umd.min.js" defer></script>
  <script src="/assets/vendor/ids/js/lib/photoswipe-lightbox.umd.min.js" defer></script>
  <script src="/assets/vendor/ids/js/gallery.js" defer></script>
  {% endif %}
  <script src="/assets/main.js" defer></script>
</head>
<body class="ids">
  <header>
    <div class="ids__wrapper XL header-layout">
    {% if page.url == '/' %}
    <span class="brand" aria-current="page">
    {% else %}
    <a class="brand brand-link" href="/" aria-label="СтройГаз — на главную">
    {% endif %}
      <span class="brand-mark" aria-hidden="true"></span>
      <span>СтройГаз</span>
    {% if page.url == '/' %}</span>{% else %}</a>{% endif %}
    <nav aria-label="Основная навигация">
      {% if page.url == '/projects/' %}<span aria-current="page">Проекты</span>{% else %}<a href="/projects/">Проекты</a>{% endif %}
      {% if page.url == '/customers/' %}<span aria-current="page">Партнёры</span>{% else %}<a href="/customers/">Партнёры</a>{% endif %}
      {% if page.url == '/design-department/' %}<span aria-current="page">Как мы работаем</span>{% else %}<a href="/design-department/">Как мы работаем</a>{% endif %}
      {% if page.url == '/about/' %}<span aria-current="page">О компании</span>{% else %}<a href="/about/">О компании</a>{% endif %}
    </nav>
    <a class="header-phone" href="tel:+78136851219">+7 (81368) 512-19</a>
    </div>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <div class="ids__wrapper XL">
    <footer class="site-footer" aria-label="Контакты компании">
      <div class="footer-grid">
        <div class="footer-main">
          <p class="footer-phone"><a href="tel:+78136851219">+7 (81368) 512-19</a></p>
          <p class="footer-phone"><a href="tel:+78136854201">+7 (81368) 542-01</a></p>
          <p class="footer-messenger">Написать в {% if contacts.whatsapp %}<a href="{{ contacts.whatsapp }}">WhatsApp</a>{% else %}<a href="#" data-placeholder-link>WhatsApp</a>{% endif %}</p>
          <p class="footer-messenger">Написать в {% if contacts.telegram %}<a href="{{ contacts.telegram }}">Telegram</a>{% else %}<a href="#" data-placeholder-link>Telegram</a>{% endif %}</p>
        </div>
        <div>
          <div class="footer-departments">
            {% for department in contacts.departments %}
            <div>
              <p class="footer-label">{{ department.name }}</p>
              <p>{% if department.example %}<a href="#" data-placeholder-link>{{ department.email }}</a>{% else %}<a href="mailto:{{ department.email }}">{{ department.email }}</a>{% endif %}</p>
            </div>
            {% endfor %}
          </div>
        </div>
        <div>
          <p class="footer-label">Адрес</p>
          <address>187110, Ленинградская область,<br>г. Кириши, проспект Победы, 30</address>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© ООО «СтройГаз» · 2006–2026</span>
      </div>
    </footer>
    <div class="ids__space S" aria-hidden="true"></div>
  </div>
</body>
</html>
